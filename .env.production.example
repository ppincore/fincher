PUBLIC_URL=https://your-domain.example
HTTP_PORT=8080
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yandex.ru
SMTP_PASS=your-yandex-app-password
SMTP_FROM=your-email@yandex.ru
FRONTEND_IMAGE=registry.example.com/your-user/personal-finance-frontend:latest
BACKEND_IMAGE=registry.example.com/your-user/personal-finance-backend:latest
