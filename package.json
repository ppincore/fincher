{
  "name": "frontend",
  "version": "0.0.1",
  "description": "Personal finance accounting",
  "scripts": {
    "start": "webpack serve --env port=3000",
    "dev:all": "sh ./scripts/dev.sh",
    "build:prod": "webpack --env mode=production",
    "build:docker": "docker compose --env-file .env.production -f docker-compose.prod.yml build",
    "push:docker": "docker compose --env-file .env.production -f docker-compose.prod.yml push",
    "build:dev": "webpack --env mode=development",
    "analyze:prod": "npm run build:prod --env analyze=true",
    "analyze:dev": "npm run build:dev --env analyze=true",
    "prettier": "npx prettier --check \"**/*.{ts,tsx,json}\" --config config/linting/.prettierrc.json --ignore-path config/linting/.prettierignore",
    "prettier:fix": "npm run prettier -- --write",
    "lint:ts": "eslint \"**/*.{ts,tsx}\" --max-warnings=0",
    "lint:ts:fix": "npm run lint:ts -- --fix",
    "lint:scss": "npx stylelint \"**/*.scss\" -c config/linting/.stylelintrc.json",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "storybook": "storybook dev --no-open -p 6006 -c ./config/.storybook",
    "storybook:build": "storybook build -c ./config/.storybook",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/imsit/personal-finances/frontend.git"
  },
  "keywords": [
    "finance",
    "accounting"
  ],
  "author": "Андрей Чернышев (bollgade)",
  "bugs": {
    "url": "https://gitlab.com/imsit/personal-finances/frontend/issues"
  },
  "homepage": "https://gitlab.com/imsit/personal-finances/frontend#readme",
